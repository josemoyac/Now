{
  "name": "now",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "next dev apps/web -p 3000",
    "dev:admin": "next dev apps/admin -p 3002",
    "dev:mobile": "cd apps/mobile && expo start",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "demo": "node scripts/dev.mjs --demo",
    "lint": "eslint apps packages db tests scripts",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/admin/tsconfig.json --noEmit && tsc -p apps/mobile/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run build:api && npm run build:web && npm run build:admin && npm run build:mobile",
    "build:api": "tsup apps/api/src/main.ts --format esm --platform node --out-dir apps/api/dist --sourcemap",
    "build:web": "next build apps/web",
    "build:admin": "next build apps/admin",
    "build:mobile": "cd apps/mobile && expo export --platform all",
    "build:ios-native": "xcodebuild -project NOW/NOW.xcodeproj -scheme NOW -sdk iphonesimulator -configuration Debug -derivedDataPath .local/xcode-derived CODE_SIGNING_ALLOWED=NO build",
    "test:ios-native": "xcodebuild -project NOW/NOW.xcodeproj -scheme NOW -sdk iphonesimulator -configuration Debug -derivedDataPath .local/xcode-derived CODE_SIGNING_ALLOWED=NO test",
    "audit:production": "npm audit --omit=dev",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.3",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.12",
    "expo-web-browser": "~57.0.3",
    "fastify": "^5.6.0",
    "ioredis": "^5.7.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.35.4",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.35.0",
    "fast-check": "^4.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^5.0.1"
  }
}
